{
  "name": "exam-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "dry-run": "npm run build && node dist/dry-run.js",
    "test:prompt": "npm run build && node dist/test-prompt.js",
    "lint": "eslint src scripts esbuild.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:dist": "node scripts/test-dist.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "sanitize-html": "2.18.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/sanitize-html": "2.16.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
