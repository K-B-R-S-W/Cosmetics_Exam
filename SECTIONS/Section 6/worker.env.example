# /etc/exam-worker.env  (chmod 600, owner root). Gemini keys live ONLY here, never on Vercel.
NODE_ENV=production

# Supabase (service role bypasses RLS: keep it secret)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE

# Operational alerts are stored in Supabase and shown on the admin Health page.

# Snapshots
SNAPSHOT_RETENTION_DAYS=14

# Gemini (three keys from three separate Google projects)
GEMINI_KEY_1=REPLACE
GEMINI_KEY_2=REPLACE
GEMINI_KEY_3=REPLACE
# model:daily_limit per key. Use the limit shown in YOUR AI Studio rate-limit page.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_DAILY_LIMITS=key1:REPLACE_LIMIT,key2:REPLACE_LIMIT,key3:REPLACE_LIMIT
# GEMINI_THINKING=            # optional, test with and without

# Grading tunables (defaults from Section 5 section 3)
GRADING_CHUNK_SIZE=10
GRADING_SLOT_MIN_INTERVAL_MS=12000
GRADING_RESERVE=1
GRADING_REQUEST_TIMEOUT_MS=90000
GRADING_MAX_TRIES=4
GRADING_PAUSE_AFTER_MIN=15
GRADING_MARK_STEP=0.5
REVIEW_CONFIDENCE=0.6
REVIEW_CONFIDENCE_SINGLISH=0.75
GRADING_MAX_ANSWER_CHARS=6000
GRADING_PROMPT_VERSION=g1
