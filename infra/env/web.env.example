# /etc/exam-web.env on the VPS. Keep root-owned with chmod 600.
# No trailing comments on variable lines (systemd keeps them in the value).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# public by design; the database gives it no access (001_initial.sql)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE
# server only. Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=REPLACE
# REQUIRED: origin.ts may see http:// behind the proxy, so without this public browser origin every POST can return 403.
ALLOWED_ORIGINS=https://APP_HOST_PLACEHOLDER

# iron-session; do not change it during an exam (it logs everyone out)
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS
# changing it later makes every stored ID hash fail to match
NIC_PEPPER=REPLACE_WITH_LONG_RANDOM_STRING

# Both LiveKit URLs must use wss://. Changes to NEXT_PUBLIC_* require rebuilding the web app.
# the token route returns this URL to the browser (plan edit E4)
LIVEKIT_URL=wss://cosmetics-exam.duckdns.org
LIVEKIT_API_KEY=REPLACE
LIVEKIT_API_SECRET=REPLACE
# only a fallback; baked in at build time
NEXT_PUBLIC_LIVEKIT_URL=wss://cosmetics-exam.duckdns.org

SNAPSHOT_RETENTION_DAYS=14
# NODE_ENV is set by exam-web.service. GEMINI_* must NOT be set here; they belong only in /etc/exam-worker.env.
