# infra/livekit/.env  -- read by the caddy container (docker-compose.yml). Not secret, but do not commit your real values.
LIVEKIT_HOST=cosmetics.duckdns.org   # create this DuckDNS name and point it at the EC2 Elastic IP
APP_HOST=app.example.duckdns.org     # set the second hostname that Caddy proxies to the Next.js app
ACME_EMAIL=you@example.com           # Let's Encrypt expiry notices go here
