# apps/web/.env.local (development) and Vercel -> Project -> Settings -> Environment Variables (Production only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE          # public by design; the database gives it no access (001_initial.sql)
SUPABASE_SERVICE_ROLE_KEY=REPLACE              # server only. Never prefix with NEXT_PUBLIC_
ALLOWED_ORIGINS=                               # optional comma-separated extra browser origins; normal requests use their own origin

SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARS   # iron-session; do not change it during an exam (it logs everyone out)
NIC_PEPPER=REPLACE_WITH_LONG_RANDOM_STRING         # changing it later makes every stored ID hash fail to match

# Local Docker Desktop LiveKit (infra/livekit/docker-compose.local.yml).
# Copy infra/livekit/livekit.local.yaml.example to livekit.local.yaml and use the same key/secret here.
LIVEKIT_URL=ws://localhost:7880                # server-only token-route URL returned to the browser
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=REPLACE_WITH_THE_SAME_32_PLUS_CHARACTER_LOCAL_SECRET
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880    # fallback only; baked in at build time
# Production reference (set in Vercel, do not use the local values): wss://cosmetics.duckdns.org

SNAPSHOT_RETENTION_DAYS=14
# NODE_ENV is set by Vercel. GEMINI_* must NOT be set here.
